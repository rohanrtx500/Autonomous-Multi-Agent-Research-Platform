# ==============================================================================
# Autonomous Multi-Agent Research Platform - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Credentials (At least one provider required)
# ------------------------------------------------------------------------------
DEFAULT_MODEL_PROVIDER=gemini        # 'gemini', 'openai', or 'groq'
DEFAULT_MODEL_NAME=gemini-2.5-flash # or 'gpt-4o-mini', 'llama-3.3-70b-versatile'

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Search & External Research Tools
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
GITHUB_TOKEN=your_github_token_here

# ------------------------------------------------------------------------------
# 3. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# SQLite is enabled by default for zero-setup local persistence.
# For production PostgreSQL, set: postgresql://user:password@localhost:5432/researchmind
DATABASE_URL=sqlite:///./data/researchmind.db

# Vector store storage directory
CHROMA_PERSIST_DIR=./data/chroma
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Distributed services (Optional)
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Security, Job Management & Runtime Policies
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_BYTES=15728640      # 15 MB
JOB_TIMEOUT_SECONDS=300             # 5 minutes
JOB_RETENTION_DAYS=30
